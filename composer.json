{
    "name": "n3xt0r/laravel-webdav-server-filament",
    "description": "Filament admin panel integration for the Laravel WebDAV Server package.",
    "keywords": [
        "N3XT0R",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "laravel-webdav-server-filament",
        "webdav",
        "webdav-server",
        "sabre",
        "sabredav",
        "admin",
        "admin-panel",
        "account-management",
        "storage",
        "file-management"
    ],
    "homepage": "https://github.com/n3xt0r/laravel-webdav-server-filament",
    "support": {
        "issues": "https://github.com/n3xt0r/laravel-webdav-server-filament/issues",
        "source": "https://github.com/n3xt0r/laravel-webdav-server-filament"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Ilya Beliaev",
            "email": "info@php-dev.info",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.0",
        "n3xt0r/laravel-webdav-server": "^1.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "laravel/boost": "^2.4",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "N3XT0R\\LaravelWebdavServerFilament\\": "src/",
            "N3XT0R\\LaravelWebdavServerFilament\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "N3XT0R\\LaravelWebdavServerFilament\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare",
            "@php ./vendor/bin/testbench package:discover --ansi"
        ],
        "lint": "pint",
        "test": "vendor/bin/phpunit --no-coverage",
        "test:lint": "pint --test",
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --host=0.0.0.0 --port=80 --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "N3XT0R\\LaravelWebdavServerFilament\\LaravelWebdavServerFilamentServiceProvider"
            ],
            "aliases": {
                "LaravelWebdavServerFilament": "N3XT0R\\LaravelWebdavServerFilament\\Facades\\LaravelWebdavServerFilament"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
